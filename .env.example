# Cle Gemini : uniquement ici (jamais dans l app Swift)
GEMINI_API_KEY=VOTRE_CLE_GEMINI
# Jeton partage avec l app iOS (en-tete X-API-Token)
API_TOKEN=VOTRE_JETON_ICI
# Modele stable et fixe (pas d alias latest) : il fait partie de la cle du cache des QCM
GEMINI_MODEL=gemini-3.8-flash
MAX_PDF_MB=20
RATE_LIMIT_PER_MINUTE=10
CACHE_DIR=.cache